#!/usr/bin/env python3
"""Fetch selected status providers and emit one bounded JSON report.

No provider ID argument selects the complete catalog for command-line use.
The desktop panel never invokes a fetch when its enabled selection is empty.
"""

from __future__ import annotations

import argparse
import json
import os
import signal
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from datetime import datetime, timezone
from pathlib import Path

from frontier_status.parsers import CatalogEntry, CompanyResult, StatusReport, PARSERS, build_company_result
from frontier_status.policy import FETCH_DEADLINE_SEC, MAX_OUTPUT_BYTES, WORKERS
from frontier_status.transport import http_get

ROOT = Path(__file__).resolve().parent
CATALOG_PATH = ROOT / "companies.json"


def arm_deadline(seconds: float = FETCH_DEADLINE_SEC) -> None:
    # A kernel deadline kills the entire process, including blocked worker threads.
    # A Python exception would wait for the executor's workers during shutdown.
    signal.signal(signal.SIGALRM, signal.SIG_DFL)
    signal.setitimer(signal.ITIMER_REAL, seconds)


def write_report(report: StatusReport | dict[str, list[CatalogEntry]]) -> None:
    """Emit complete ASCII JSON within the output budget, never a partial report."""
    chunks = []
    size = 1  # trailing newline
    for chunk in json.JSONEncoder(ensure_ascii=True).iterencode(report):
        size += len(chunk)
        if size > MAX_OUTPUT_BYTES:
            raise ValueError("Status report exceeds output limit")
        chunks.append(chunk)
    sys.stdout.write("".join(chunks) + "\n")


def load_catalog() -> list[CatalogEntry]:
    with CATALOG_PATH.open(encoding="utf-8") as handle:
        data = json.load(handle)
    if not isinstance(data, list):
        raise SystemExit("companies.json must be a JSON array")
    return data


def utc_now() -> str:
    return datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def fetch_company(row: CatalogEntry) -> CompanyResult:
    """Convert provider or transport exceptions into a bounded unknown result."""
    kind = str(row.get("kind") or "")
    parser = PARSERS.get(kind)
    if parser is None:
        return build_company_result(row, error=f"unknown status kind {kind!r}")
    try:
        body, _content_type = http_get(str(row["endpoint"]))
        return parser(body, row)
    except Exception as exc:
        return build_company_result(row, error=str(exc))


def selected_rows(catalog: list[CatalogEntry], enabled_ids: list[str] | None) -> list[CatalogEntry]:
    if not enabled_ids:
        return list(catalog)
    wanted = set(enabled_ids)
    rows = [row for row in catalog if row["id"] in wanted]
    return rows


def fetch_report(catalog: list[CatalogEntry], enabled_ids: list[str] | None) -> StatusReport:
    """Fetch concurrently, retaining catalog order and per-provider failures.

    The command entry point owns the hard process deadline; callers importing
    this function must provide that lifecycle boundary themselves.
    """
    rows = selected_rows(catalog, enabled_ids)
    companies = []
    if not rows:
        return {"ok": True, "fetchedAt": utc_now(), "companies": []}
    with ThreadPoolExecutor(max_workers=min(WORKERS, len(rows))) as pool:
        futures = {pool.submit(fetch_company, row): row["id"] for row in rows}
        by_id: dict[str, CompanyResult] = {}
        for future in as_completed(futures):
            by_id[futures[future]] = future.result()
    for row in rows:
        companies.append(by_id[row["id"]])
    return {"ok": True, "fetchedAt": utc_now(), "companies": companies}


def parse_id_list(raw: str | None) -> list[str] | None:
    if raw is None or raw.strip() == "":
        return None
    return [part.strip() for part in raw.split(",") if part.strip()]


def main(argv: list[str] | None = None) -> int:
    arm_deadline()
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("catalog", help="Print the company catalog")
    fetch_parser = sub.add_parser("fetch", help="Fetch enabled company status pages")
    fetch_parser.add_argument("--enabled", default="", help="Comma-separated company ids")
    args = parser.parse_args(argv)
    command = args.command or "fetch"
    catalog = load_catalog()
    if command == "catalog":
        write_report({"companies": catalog})
        return 0
    enabled = parse_id_list(getattr(args, "enabled", ""))
    report = fetch_report(catalog, enabled)
    write_report(report)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except BrokenPipeError:
        os._exit(0)
    except Exception:
        # Remote exception text and tracebacks must not become unbounded stderr.
        sys.stderr.write("Status fetch failed\n")
        raise SystemExit(1)
